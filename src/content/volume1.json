    {
      "id": "v1_pages_talk",
      "narration": "门开一线。账房先生脸色灰败，像被旧账压弯的人。",
      "speakers": [
        {
          "speaker": "账房先生",
          "text": "缺页我藏着。不是为害你——是为留活口。并账那一夜，死人的名字不该见光。"
        },
        {
          "speaker": "昭宁",
          "text": "见光，才不死第二次。"
        }
      ],
      "choices": [
        {
          "id": "c_talk_get_pages",
          "text": "要回缺页",
          "effects": {
            "goto": "v1_pages_found"
          }
        },
        {
          "id": "c_talk_debt",
          "text": "逼他立刻并账",
          "effects": {
            "goto": "v1_debt"
          }
        }
      ]
    },
    {
      "id": "v1_pages_found",
      "narration": "缺页归位。墨与掐痕对上——寅年冬，你「病重」那几日的银货往来，写得清清楚楚。还有一行被圈住的字：人归则账完。",
      "speakers": [
        {
          "speaker": "账房先生",
          "text": "你要的证据在这儿。接下来只有两条路：并账，或等人归。"
        },
        {
          "speaker": "昭宁",
          "text": "我两条都要。"
        }
      ],
      "choices": [
        {
          "id": "c_pages_confirm",
          "text": "封存缺页入账本",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_missing_pages",
                "kind": "物",
                "title": "密册缺页",
                "detail": "寅年冬病重期间银货往来。圈注：人归则账完。"
              }
            ],
            "confirmLedger": [
              "ledger_missing_pages"
            ],
            "setFlags": [
              "got_missing_pages"
            ],
            "goto": "v1_fork"
          }
        }
      ]
    },
    {
      "id": "v1_fork",
      "title": "分岔",
      "narration": "窗外天光将白。你可以现在结案，也可以把针再往深处扎。",
      "onEnter": {
        "checkpoint": true
      },
      "speakers": [
        {
          "speaker": "青禾",
          "text": "小姐……我们赢一截了吧？"
        },
        {
          "speaker": "昭宁",
          "text": "赢一截，不等于账完。"
        }
      ],
      "choices": [
        {
          "id": "c_fork_end_pages",
          "text": "以缺页为证，暂收卷一（结局：缺页之证）",
          "require": {
            "flags": [
              "got_missing_pages"
            ]
          },
          "effects": {
            "ending": "ending_missing_page"
          }
        },
        {
          "id": "c_fork_debt",
          "text": "转入讨债并账",
          "effects": {
            "goto": "v1_debt"
          }
        },
        {
          "id": "c_fork_return",
          "text": "去等人归",
          "require": {
            "flags": [
              "return_hint"
            ]
          },
          "showLocked": true,
          "lockedHint": "需已获「人归」相关线索",
          "effects": {
            "goto": "v1_return"
          }
        },
        {
          "id": "c_fork_return_alt",
          "text": "凭缺页上的圈注去等",
          "require": {
            "flags": [
              "got_missing_pages"
            ]
          },
          "effects": {
            "setFlags": [
              "return_hint"
            ],
            "goto": "v1_return"
          }
        }
      ]
    },
    {
      "id": "v1_debt",
      "title": "第16章气质 · 讨债并账",
      "narration": "并账桌摆在药铺内室。烛火跳。对面坐着代沈府出面的人——你认出继母的私印在契尾。",
      "onEnter": {
        "checkpoint": true
      },
      "speakers": [
        {
          "speaker": "账房先生",
          "text": "旧债新债，今日并。谁签字，谁担。"
        },
        {
          "speaker": "昭宁",
          "text": "继母的印，我认。人，呢？"
        },
        {
          "speaker": "？？？",
          "text": "人在门外。先把数算清。"
        }
      ],
      "choices": [
        {
          "id": "c_debt_pages",
          "text": "甩出缺页逼签",
          "require": {
            "ledger": [
              "ledger_missing_pages"
            ]
          },
          "showLocked": true,
          "lockedHint": "需已取得密册缺页",
          "effects": {
            "setFlags": [
              "debt_pressed"
            ],
            "goto": "v1_debt_sign"
          }
        },
        {
          "id": "c_debt_case",
          "text": "以立案号威胁公开",
          "require": {
            "ledger": [
              "ledger_case"
            ]
