            "confirmLedger": [
              "ledger_threat"
            ],
            "goto": "v1_debt"
          }
        }
      ]
    },
    {
      "id": "v1_pharmacy",
      "title": "药铺后门",
      "narration": "药香混着陈墨。后门上锁。你试钥——或敲三下，报「并账」。",
      "onEnter": {
