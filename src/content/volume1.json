          "showLocked": true,
          "lockedHint": "需已立案",
          "effects": {
            "deltaPublicity": 10,
            "setFlags": [
              "debt_pressed"
            ],
            "goto": "v1_debt_sign"
          }
        },
        {
          "id": "c_debt_threat",
          "text": "用恐吓帖反制",
          "require": {
            "ledger": [
              "ledger_threat"
            ]
          },
          "showLocked": true,
          "lockedHint": "需持有恐吓帖",
          "effects": {
            "setFlags": [
              "debt_pressed"
            ],
            "goto": "v1_debt_sign"
          }
        },
        {
          "id": "c_debt_secret",
          "text": "用废园密册施压",
          "require": {
            "ledger": [
              "ledger_secret_book"
            ]
          },
          "showLocked": true,
          "lockedHint": "需持有废园密册",
          "effects": {
            "setFlags": [
              "debt_pressed"
            ],
            "goto": "v1_debt_sign"
          }
        },
        {
          "id": "c_debt_reckless",
          "text": "空手硬谈（险）",
          "effects": {
            "goto": "v1_debt_empty"
          }
        }
      ]
    },
    {
      "id": "v1_debt_empty",
      "narration": "没有物证的谈判，像空手接刀。对方笑着起身。",
      "speakers": [
        {
          "speaker": "？？？",
          "text": "沈二姑娘，你的命很贵。别在这儿耗。"
        }
      ],
      "choices": [
        {
          "id": "c_empty_back",
          "text": "先撤，补证据再来",
          "effects": {
            "goto": "v1_needle"
          }
        },
        {
          "id": "c_empty_death",
          "text": "掀桌硬拼",
          "effects": {
            "death": true
          }
        }
      ]
    },
    {
      "id": "v1_debt_sign",
      "narration": "契纸摊开。对方握笔的手抖了一下，终于落款。银数对冲，命债另记——你没让那一行被墨涂掉。",
      "speakers": [
        {
          "speaker": "昭宁",
          "text": "并账可以。抹人，不行。"
        },
        {
          "speaker": "账房先生",
          "text": "……你比他们想的难缠。"
        }
      ],
      "choices": [
        {
          "id": "c_debt_end",
          "text": "收契离场（结局：并账清场）",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_debt_deed",
                "kind": "数",
                "title": "并账契",
                "detail": "药铺内室所签。银货对冲，命债另记，不可涂抹。"
              }
            ],
            "confirmLedger": [
              "ledger_debt_deed"
            ],
            "ending": "ending_debt_cleared"
          }
        },
        {
          "id": "c_debt_then_return",
          "text": "契已签，仍去见「归人」",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_debt_deed",
                "kind": "数",
                "title": "并账契",
                "detail": "药铺内室所签。银货对冲，命债另记，不可涂抹。"
              }
            ],
            "confirmLedger": [
              "ledger_debt_deed"
            ],
            "setFlags": [
              "debt_done",
              "return_hint"
            ],
            "goto": "v1_return"
          }
        }
      ]
    },
    {
      "id": "v1_return",
      "title": "第20章气质 · 人归",
      "narration": "雨后的巷口。青袍先到——不是裴玄，是另一个你不该再见到的背影。他转身，像把上一世未说完的话咽回去。",
      "onEnter": {
        "checkpoint": true
      },
      "speakers": [
        {
          "speaker": "归人",
          "text": "……昭宁。你不该用命来换这些纸。"
        },
        {
          "speaker": "昭宁",
          "text": "纸能换命。你当时不在。"
        },
        {
          "speaker": "归人",
          "text": "我在。只是回来得太晚。"
        }
      ],
      "choices": [
        {
          "id": "c_return_confront",
          "text": "对质：缺页、并账、七条命",
          "effects": {
            "setFlags": [
              "confronted_return"
            ],
            "goto": "v1_return_talk"
          }
        },
        {
          "id": "c_return_soft",
          "text": "先问一句：为何现在归",
          "effects": {
            "deltaBonds": {
              "peixuan": 0
            },
            "goto": "v1_return_why"
          }
        },
        {
          "id": "c_return_trap",
          "text": "怀疑是局，抽身（险）",
          "effects": {
            "goto": "v1_return_trap"
          }
        }
      ]
    },
    {
      "id": "v1_return_why",
      "narration": "他沉默很久。雨滴从檐角落下，像在数。",
      "speakers": [
        {
          "speaker": "归人",
          "text": "因为有人把钥匙塞进井栏。因为缺页圈着「人归则账完」。因为——听说你还剩几条命。"
        },
        {
          "speaker": "昭宁",
          "text": "几条，我自己数。"
        }
      ],
      "choices": [
        {
          "id": "c_why_to_talk",
          "text": "继续对质",
          "effects": {
            "goto": "v1_return_talk"
          }
        }
      ]
    },
    {
      "id": "v1_return_trap",
      "narration": "巷尾有脚步。你撤得快——却踩空一阶。",
      "speakers": [
        {
          "speaker": "青禾",
          "text": "小姐！"
        }
      ],
      "choices": [
        {
          "id": "c_trap_death",
          "text": "……（坠落）",
          "effects": {
            "death": true
          }
