            "goto": "v1_needle"
          }
        },
        {
          "id": "c_grab_hard",
          "text": "逼问到底（险）",
          "effects": {
            "death": true
          }
        }
      ]
    },
    {
      "id": "v1_key_msg",
      "narration": "少年把钥收回，只留下一句。",
      "speakers": [
        {
          "speaker": "递钥人",
          "text": "缺页在账房。人——会归。你若不要钥，就收针，别乱扯线。"
        },
        {
          "speaker": "昭宁",
          "text": "收针。我懂。"
        }
      ],
      "choices": [
        {
          "id": "c_msg_needle",
          "text": "转入收针",
          "effects": {
            "setFlags": [
              "know_pharmacy",
              "return_hint"
            ],
            "addLedger": [
              {
                "id": "ledger_return_hint",
                "kind": "事",
                "title": "口信：人归",
                "detail": "递钥人口信：缺页在账房；有人将归。"
              }
            ],
            "confirmLedger": [
              "ledger_return_hint"
            ],
            "goto": "v1_needle"
          }
        }
      ]
    },
    {
      "id": "v1_needle",
      "title": "第12章气质 · 收针",
      "narration": "所谓收针，不是缝衣——是把散落的线头收回来，不让人顺着扯到你喉咙。\n你把缺页、钥、立案号与半页残账摊开，像布阵。",
      "onEnter": {
        "checkpoint": true
      },
      "speakers": [
        {
          "speaker": "青禾",
          "text": "小姐，我们……是去药铺，还是先并账？"
        },
        {
          "speaker": "昭宁",
          "text": "针要收紧，才能扎得准。"
        }
      ],
      "choices": [
        {
          "id": "c_needle_pharmacy",
          "text": "先赴城西药铺",
          "require": {
            "flags": [
              "know_pharmacy"
            ]
          },
          "showLocked": true,
          "lockedHint": "需已知药铺后门线索",
          "effects": {
            "goto": "v1_pharmacy"
          }
        },
        {
          "id": "c_needle_debt",
          "text": "先讨债并账",
          "require": {
            "flags": [
              "key_hint"
            ]
          },
          "showLocked": true,
          "lockedHint": "需已获得缺页/递钥相关线索",
