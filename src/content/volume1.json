        {
          "id": "c_trap_recover",
          "text": "抓住归人伸来的手",
          "require": {
            "flags": [
              "scar_made"
            ]
          },
          "showLocked": true,
          "lockedHint": "腕上有疤者抓得更稳（序章选择）",
          "effects": {
            "setFlags": [
              "trust_return"
            ],
            "goto": "v1_return_talk"
          }
        }
      ]
    },
    {
      "id": "v1_return_talk",
      "narration": "你们站在雨里，把该算的都摊开：缺页、钥、契、命。他没有求你原谅，只求你把账本合上之前，留一行给他改。",
      "speakers": [
        {
          "speaker": "归人",
          "text": "卷一可以完。后面的——我陪你算。"
        },
        {
          "speaker": "昭宁",
          "text": "陪？先把这一卷签完。"
        }
      ],
      "choices": [
        {
          "id": "c_return_end",
          "text": "允他对质入账（结局：人归）",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_return",
                "kind": "人",
                "title": "归人对质",
                "detail": "雨巷相认。非团圆，是对质。卷一可结。"
              }
            ],
            "confirmLedger": [
              "ledger_return"
            ],
            "ending": "ending_return"
          }
        },
        {
          "id": "c_return_pages_end",
          "text": "以人归印证缺页，收束（结局：缺页之证）",
          "require": {
            "flags": [
              "got_missing_pages"
            ]
          },
          "showLocked": true,
          "lockedHint": "需已取得缺页",
          "effects": {
            "confirmLedger": [
              "ledger_missing_pages"
            ],
            "ending": "ending_missing_page"
          }
        },
        {
          "id": "c_return_debt_end",
          "text": "拉他去看并账契（结局：并账清场）",
          "require": {
            "flags": [
              "debt_done"
            ]
          },
          "showLocked": true,
          "lockedHint": "需已完成并账",
          "effects": {
            "ending": "ending_debt_cleared"
          }
        }
      ]
    }
