            "goto": "v1_debt"
          }
        },
        {
          "id": "c_needle_rush",
          "text": "公开张扬，逼对方露头（险）",
          "effects": {
            "deltaPublicity": 25,
            "goto": "v1_needle_rush"
          }
        }
      ]
    },
    {
      "id": "v1_needle_rush",
      "narration": "你故意在茶楼丢下一句「沈府缺页将公示」。半个时辰后，有人塞来恐吓帖。",
      "speakers": [
        {
          "speaker": "昭宁",
          "text": "恐吓帖也是账。写进本子。"
        }
      ],
      "choices": [
        {
          "id": "c_rush_pull_back",
          "text": "收声，改走暗线",
          "require": {
            "maxPublicity": 60
          },
