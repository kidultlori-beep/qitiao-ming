{
  "id": "volume1",
  "title": "卷一 · 账未完",
  "description": "缺页、递钥、收针、讨债并账、人归——序章之后的骨架。原创旁白与对白，非整章粘贴。",
  "startNode": "v1_bridge",
  "npcs": [
    {
      "id": "qinghe",
      "name": "青禾",
      "intro": "贴身丫头，怕却忠。"
    },
    {
      "id": "peixuan",
      "name": "裴玄",
      "intro": "青袍玉佩，话少。"
    },
    {
      "id": "wupo",
      "name": "吴婆子",
      "intro": "城南角门管事。"
    },
    {
      "id": "jimo",
      "name": "继母",
      "intro": "笑里藏刀。"
    },
    {
      "id": "keyboy",
      "name": "递钥人",
      "intro": "夜里敲门的少年。"
    },
    {
      "id": "zhanggui",
      "name": "账房先生",
      "intro": "沈府旧账经手人。"
    }
  ],
  "endings": [
    {
      "id": "ending_missing_page",
      "title": "缺页之证",
      "summary": "你补齐密册缺页，把沈府最大的一笔「意外」钉死在纸上。命还在，账本合了一半——够用。",
      "kind": "clear"
    },
    {
      "id": "ending_debt_cleared",
      "title": "并账清场",
      "summary": "讨债并账那一夜，银与命对冲。你没赢尽，却把对方逼到桌边签字。卷一暂结。",
      "kind": "clear"
    },
    {
      "id": "ending_return",
      "title": "人归",
      "summary": "该回来的人回来了。不是团圆，是对质。七条命还剩几条，你第一次愿意当面数给他听。",
      "kind": "clear"
    },
    {
      "id": "ending_needle_bad",
      "title": "针线封口",
      "summary": "你收得太急，线头被人拽住。公开度过高，卷一以「暂避」收场——账未完，人先走。",
      "kind": "bad"
    },
    {
      "id": "game_over",
      "title": "命尽",
      "summary": "七条命皆尽。账本合上，灯熄。",
      "kind": "death"
    }
  ],
  "nodes": [
    {
      "id": "v1_bridge",
      "title": "卷一 · 起",
      "narration": "序章的火还未冷。密册或立案号，已在你掌心。青禾把窗关严，只留一条缝给夜风。\n昭宁摊开纸——有些字被人挖去，像伤口。",
      "onEnter": {
        "checkpoint": true,
        "setFlags": [
          "entered_volume1"
        ]
      },
      "speakers": [
        {
          "speaker": "青禾",
          "text": "小姐……这本子少了好几页。像被人故意撕的。"
        },
        {
          "speaker": "昭宁",
          "text": "撕得干净，说明怕。怕的人，最容易留下线头。"
        }
      ],
      "choices": [
        {
          "id": "c_v1_start",
          "text": "先查缺页从何处起",
          "effects": {
            "goto": "v1_missing"
          }
        },
        {
          "id": "c_v1_start_case",
          "text": "先拿立案号去换线索",
          "require": {
            "ledger": [
              "ledger_case"
            ]
          },
          "showLocked": true,
          "lockedHint": "需持有大理寺立案号",
          "effects": {
            "setFlags": [
              "used_case_for_clue"
            ],
            "goto": "v1_missing"
          }
        }
      ]
    },
    {
      "id": "v1_missing",
      "title": "第5章气质 · 缺页",
      "narration": "灯下对照：缺页集中在「寅年冬」与「卯年春」两段。墨迹断裂处，隐约有指甲掐痕。",
      "onEnter": {
        "checkpoint": true
      },
      "speakers": [
        {
          "speaker": "昭宁",
          "text": "不是偶发。是有人专撕与我相关的那几夜。"
        },
        {
          "speaker": "青禾",
          "text": "那……去找谁要？"
        }
      ],
      "choices": [
        {
          "id": "c_ask_wupo_page",
          "text": "回废园问吴婆子",
          "require": {
            "flags": [
              "door_open"
            ]
          },
          "showLocked": true,
          "lockedHint": "需曾打开废园角门",
          "effects": {
            "deltaBonds": {
              "wupo": 1
            },
            "goto": "v1_wupo_page"
          }
        },
        {
          "id": "c_ask_pei_page",
          "text": "把缺页痕迹给裴玄看",
          "require": {
            "bonds": {
              "peixuan": 2
            }
          },
          "showLocked": true,
          "lockedHint": "需裴玄好感≥2",
          "effects": {
            "deltaBonds": {
              "peixuan": 1
            },
            "goto": "v1_pei_page"
          }
        },
        {
          "id": "c_search_self",
          "text": "自己连夜翻府中旧箱",
          "effects": {
            "deltaPublicity": 5,
            "goto": "v1_box_search"
          }
        }
      ]
    },
    {
      "id": "v1_wupo_page",
      "narration": "吴婆子认物不认人。她盯着缺页边缘，忽然啐一口。",
      "speakers": [
        {
          "speaker": "吴婆子",
          "text": "撕纸的人，夜里递过一把钥匙。不是给我——是塞进井栏缝。"
        },
        {
          "speaker": "昭宁",
          "text": "钥匙还在？"
        },
        {
          "speaker": "吴婆子",
          "text": "在不在，看你敢不敢去摸。"
        }
      ],
      "choices": [
        {
          "id": "c_take_well_hint",
          "text": "记下「井栏缝」与递钥人",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_key_hint",
                "kind": "事",
                "title": "井栏递钥",
                "detail": "吴婆子称：撕缺页之人曾把钥匙塞进废园井栏缝。"
              }
            ],
            "confirmLedger": [
              "ledger_key_hint"
            ],
            "setFlags": [
              "key_hint"
            ],
            "goto": "v1_key_night"
          }
        }
      ]
    },
    {
      "id": "v1_pei_page",
      "narration": "裴玄只看一眼缺页，便把纸推回。玉佩轻响。",
      "speakers": [
        {
          "speaker": "裴玄",
          "text": "撕得整齐，像账房手势。沈府旧账房——还活着。"
        },
        {
          "speaker": "昭宁",
          "text": "人在哪？"
        },
        {
          "speaker": "裴玄",
          "text": "城西药铺后门。别提我名。"
        }
      ],
      "choices": [
        {
          "id": "c_pei_clue",
          "text": "收下线索，准备夜访",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_zhanggui_clue",
                "kind": "人",
                "title": "旧账房下落",
                "detail": "城西药铺后门。裴玄暗示：撕页手势像账房。"
              }
            ],
            "confirmLedger": [
              "ledger_zhanggui_clue"
            ],
            "setFlags": [
              "zhanggui_clue",
              "key_hint"
            ],
            "deltaBonds": {
              "peixuan": 1
            },
            "goto": "v1_key_night"
          }
        }
      ]
    },
    {
      "id": "v1_box_search",
      "narration": "旧箱里尽是霉味与碎绢。你摸到一截铜匙——齿纹生疏，像新配的。箱底还有半页被揉皱的账，字迹被水洇开。",
      "speakers": [
        {
          "speaker": "青禾",
          "text": "小姐，这钥匙……烫手。"
        },
        {
          "speaker": "昭宁",
          "text": "烫，才说明有人急着藏。"
        }
      ],
      "choices": [
        {
          "id": "c_box_key",
          "text": "收下铜匙与半页残账",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_copper_key",
                "kind": "物",
                "title": "生铜匙",
                "detail": "旧箱中所得。齿纹新，用途不明。"
              },
              {
                "id": "ledger_half_page",
                "kind": "物",
                "title": "半页残账",
                "detail": "水洇字迹，隐约可见「并账」二字。"
              }
            ],
            "confirmLedger": [
              "ledger_copper_key",
              "ledger_half_page"
            ],
            "setFlags": [
              "has_copper_key",
              "key_hint"
            ],
            "goto": "v1_key_night"
          }
        },
        {
          "id": "c_box_noise",
          "text": "动静太大，被人撞见（险）",
          "effects": {
            "deltaPublicity": 15,
            "goto": "v1_box_caught"
          }
        }
      ]
    },
    {
      "id": "v1_box_caught",
      "narration": "继母的影子挡在门框。她笑，笑意不到眼。",
      "speakers": [
        {
          "speaker": "继母",
          "text": "二姑娘夜不归寝，还翻旧物？是想给谁看？"
        },
        {
          "speaker": "昭宁",
          "text": "给账本看。"
        }
      ],
      "choices": [
        {
          "id": "c_caught_bluff",
          "text": "硬扛：缺页问罪",
          "effects": {
            "deltaPublicity": 10,
            "setFlags": [
              "jimo_alert"
            ],
            "goto": "v1_key_night"
          }
        },
        {
          "id": "c_caught_flee",
          "text": "借青禾掩护撤走",
          "effects": {
            "deltaBonds": {
              "qinghe": 2
            },
            "goto": "v1_key_night"
          }
        }
      ]
    },
    {
      "id": "v1_key_night",
      "title": "第8章气质 · 递钥",
      "narration": "三更。有人叩你窗棂，三短一长。青禾握剪，你只说开门。",
      "onEnter": {
        "checkpoint": true
      },
      "speakers": [
        {
          "speaker": "递钥人",
          "text": "……沈二姑娘。有人让我把这个给你。不要问名。"
        },
        {
          "speaker": "昭宁",
          "text": "问名没用。问——钥匙开哪扇门。"
        }
      ],
      "choices": [
        {
          "id": "c_accept_key",
          "text": "接钥，放人走",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_night_key",
                "kind": "物",
                "title": "夜叩之钥",
                "detail": "少年所递。寒铁，柄上刻半个「归」字。"
              }
            ],
            "confirmLedger": [
              "ledger_night_key"
            ],
            "setFlags": [
              "has_night_key"
            ],
            "goto": "v1_key_ask"
          }
        },
        {
          "id": "c_grab_boy",
          "text": "扣住少年追问",
          "effects": {
            "deltaPublicity": 8,
            "goto": "v1_key_grab"
          }
        },
        {
          "id": "c_refuse_key",
          "text": "拒收，只问口信",
          "effects": {
            "setFlags": [
              "refused_key"
            ],
            "goto": "v1_key_msg"
          }
        }
      ]
    },
    {
      "id": "v1_key_ask",
      "narration": "少年退后半步，喉结滚动。",
      "speakers": [
        {
          "speaker": "递钥人",
          "text": "城西药铺。后门。说「并账」——才会开。"
        },
        {
          "speaker": "昭宁",
          "text": "谁教你的？"
        },
        {
          "speaker": "递钥人",
          "text": "……一个不肯回家的人。"
        }
      ],
      "choices": [
        {
          "id": "c_key_to_needle",
          "text": "记下，转入收针",
          "effects": {
            "setFlags": [
              "know_pharmacy"
            ],
            "goto": "v1_needle"
          }
        }
      ]
    },
    {
      "id": "v1_key_grab",
      "narration": "你扣腕。少年痛呼，怀中掉出一张纸条——字迹熟悉得像上一世临终前见过。",
      "speakers": [
        {
          "speaker": "递钥人",
          "text": "别……别害他！他只是想把缺页还你！"
        },
        {
          "speaker": "昭宁",
          "text": "「他」是谁。"
        }
      ],
      "choices": [
        {
          "id": "c_grab_soft",
          "text": "松手，换信任",
          "effects": {
            "addLedger": [
              {
                "id": "ledger_return_note",
                "kind": "事",
                "title": "归人纸条",
                "detail": "「缺页在账房。钥开后门。人，会归。」"
              },
              {
                "id": "ledger_night_key",
                "kind": "物",
                "title": "夜叩之钥",
                "detail": "少年所携。柄上刻半个「归」字。"
              }
            ],
            "confirmLedger": [
